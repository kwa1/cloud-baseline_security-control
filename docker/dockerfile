# =========================
# Stage 1: Builder
# =========================
FROM registry.redhat.io/ubi9/python-312:latest AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

# Dependencies are installed into an isolated venv that is copied to the runtime stage.
COPY scripts/requirements.txt .
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# =========================
# Stage 2: Runtime (non-root)
# =========================
FROM registry.redhat.io/ubi9/python-312-minimal:latest

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER root
RUN useradd -r -u 10001 -g 0 appuser \
    && mkdir -p /app

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=10001:0 scripts/ scripts/

USER 10001

# Health: the pinned dependency set imports and the analyzers are present.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python3 -c "import boto3; import json" && test -f scripts/owasp_analyzer.py || exit 1

CMD ["python3", "scripts/owasp_analyzer.py", "--help"]
